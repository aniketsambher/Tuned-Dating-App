PORT=3000
DATABASE_URL=postgres://tuned:tuned@localhost:5432/tuned
# Apply database migrations automatically when the server starts.
RUN_MIGRATIONS=true

# Create an app at https://developer.spotify.com/dashboard and add this exact redirect URI.
# Spotify doesn't accept "localhost" redirect URIs; use the loopback IP.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Long random strings. `npm run setup` fills these in for you.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Where to send the user after login (the session token is appended as a URL fragment).
# Points at the built-in web UI. Leave empty to get a raw JSON response from the callback instead.
APP_REDIRECT_URL=http://127.0.0.1:3000/

# Matching weights (must be non-negative; they are normalized to sum to 1).
MATCH_ARTIST_WEIGHT=0.6
MATCH_GENRE_WEIGHT=0.4
